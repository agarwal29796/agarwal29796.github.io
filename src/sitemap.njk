---
permalink: /sitemap.xml
sitemap: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and p.data.sitemap != false and p.page.outputFileExtension == "html" %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ (p.data.updated or p.date) | isoDate }}</lastmod>
  </url>
{%- endif %}{% endfor %}
</urlset>
