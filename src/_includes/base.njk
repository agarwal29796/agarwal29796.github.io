<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set isPost = tags and ("posts" in tags) -%}
  {%- set pageTitle = title if title else site.name -%}
  {%- set fullTitle = (title + " · " + site.name) if title else (site.name + " · " + site.tagline) -%}
  {%- set pageDesc = description if description else site.description -%}
  {%- set pageUrl = site.url + page.url -%}
  {%- set pageImage = site.url + (image if image else site.image) -%}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="author" content="{{ site.author.name }}">
  <link rel="canonical" href="{{ pageUrl }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImage }}">
  {%- if isPost %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:modified_time" content="{{ (updated or page.date) | isoDate }}">
  <meta property="article:author" content="{{ site.author.name }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ pageImage }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">
  <link rel="icon" href="/img/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/archit.png">
  <meta name="theme-color" content="#0f172a">
  <link rel="stylesheet" href="/css/style.css">
  {#- Structured data: Person everywhere, plus BlogPosting on posts, WebSite on the home page, ProfilePage on About. #}
  {%- set sameAs = [site.author.github] -%}
  {%- if site.author.linkedin %}{% set _ = sameAs.push(site.author.linkedin) %}{% endif -%}
  {%- set person = { "@type": "Person", "name": site.author.name, "url": site.url + "/", "image": site.url + site.avatar, "jobTitle": site.author.role, "sameAs": sameAs } -%}
  {%- if isPost -%}
    {%- set ld = { "@context": "https://schema.org", "@type": "BlogPosting", "headline": title, "description": pageDesc, "url": pageUrl, "mainEntityOfPage": pageUrl, "datePublished": page.date | isoDate, "dateModified": (updated or page.date) | isoDate, "image": pageImage, "inLanguage": site.lang, "author": person, "publisher": person } -%}
  {%- elif page.url == "/" -%}
    {%- set ld = { "@context": "https://schema.org", "@type": "WebSite", "name": site.name, "url": site.url + "/", "description": site.description, "inLanguage": site.lang, "author": person } -%}
  {%- elif page.url == "/about/" -%}
    {%- set ld = { "@context": "https://schema.org", "@type": "ProfilePage", "url": pageUrl, "dateModified": (updated or page.date) | isoDate, "mainEntity": person } -%}
  {%- else -%}
    {%- set ld = { "@context": "https://schema.org", "@type": "WebPage", "name": pageTitle, "url": pageUrl, "description": pageDesc, "author": person } -%}
  {%- endif %}
  <script type="application/ld+json">{{ ld | dump | safe }}</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav aria-label="Main">
      <a href="/">Log</a>
      <a href="/about/">About</a>
      <a href="/now/">Now</a>
      <a href="/feed.xml">Feed</a>
    </nav>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>{{ site.author.name }} · <a href="{{ site.author.github }}" rel="me">GitHub</a>{% if site.author.linkedin %} · <a href="{{ site.author.linkedin }}" rel="me">LinkedIn</a>{% endif %} · <a href="/feed.xml">Feed</a> · © {{ buildYear }}</p>
  </footer>
</body>
</html>
